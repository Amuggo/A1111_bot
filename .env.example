# ===== Пример конфигурации окружения =====
# Скопируйте этот файл в .env и заполните значения.
# Файл .env НЕ должен попадать в git (уже добавлен в .gitignore).

# ОБЯЗАТЕЛЬНО: токен Telegram-бота (получить у @BotFather)
TELEGRAM_BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Адрес Stable Diffusion WebUI (AUTOMATIC1111) API, запущенного с флагом --api
SD_BASE_URL=http://127.0.0.1:7860

# Адрес Ollama для LLM-обработки промптов (опционально)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=aya:8b

# Каталог для данных (настройки пользователей, лица, логи). По умолчанию: code/data
# DATA_DIR=/var/lib/sd-bot/data

# Логирование промптов пользователей: 1 — включено, 0 — выключено
PROMPT_LOG_ENABLED=1

# Telegram user_id администратора для команды /prompts (опционально;
# если не задано — лог может посмотреть любой, кто напишет боту /prompts)
ADMIN_USER_ID=

# Путь к папке, где лежит stable-diffusion-webui (нужен для embeddings_manager.py)
# A1111_BASE_PATH=N:\A1111

# Модель по умолчанию для пользователей, которые не выбирали модель (имя или title из списка WebUI).
# Если не задано — используется модель, загруженная в WebUI в момент запуска бота.
# SD_DEFAULT_MODEL=

# УСТАРЕЛО: BOT_WORKER_THREADS / WORKER_THREADS больше не используются — бот полностью асинхронный (asyncio), без пула потоков.

# Отправлять картинки тяжелее N МБ файлом (без сжатия Telegram). По умолчанию — лимит Telegram на фото (10 МБ).
# SEND_AS_FILE_ABOVE_MB=

# Папка виртуального окружения. По умолчанию ищется <проект>/env (затем .venv, venv);
# бот сам перезапускается её интерпретатором. Здесь можно указать другой путь:
# PROJECT_ENV_DIR=
# Отключить автоматическое подключение окружения (запуск текущим Python):
# NO_ENV_BOOTSTRAP=1

# ===== Асинхронный режим (aiogram + aiohttp) =====
# Режим Telegram: polling (long polling, по умолчанию) или webhook
BOT_MODE=polling
# Long polling: сколько секунд Telegram держит запрос
POLLING_TIMEOUT=10
# Для BOT_MODE=webhook: публичный адрес БЕЗ пути (https://example.com), секрет и параметры локального сервера
# WEBHOOK_URL=
# WEBHOOK_SECRET=
# WEBHOOK_PATH=/webhook
# WEBAPP_HOST=0.0.0.0
# WEBAPP_PORT=8080

# Очередь задач генерации
# Сколько задач обрабатывается одновременно (воркеров очереди)
QUEUE_WORKERS=2
# Максимум задач в очереди и на одного пользователя
QUEUE_MAXSIZE=50
QUEUE_MAX_PER_USER=3
# Сколько запросов бот одновременно шлёт в WebUI. WebUI сам считает по одной генерации (очередь внутри
# сервера), поэтому 1 — так «Отменить» прерывает именно нужную задачу. Увеличивайте только если WebUI это умеет.
SD_MAX_PARALLEL=1

# HTTP-клиент: максимальная пауза без данных от WebUI, секунд (общий таймаут не ограничен: генерация может идти минуты)
HTTP_SOCK_READ_TIMEOUT=300
HTTP_SOCK_CONNECT_TIMEOUT=10

# Лица: FaceID (IP-Adapter через ControlNet). Всё необязательно — значения по умолчанию подходят для SD 1.5.
# FACEID_BASE=sd15            # sd15 | sdxl — какую версию FaceID-модели и LoRA искать
# FACEID_CN_MODEL=            # точное имя ControlNet-модели, если автопоиск не подходит
# FACEID_MODULE=              # препроцессор (по умолчанию ip-adapter_face_id_plus)
# FACEID_LORA=                # имя LoRA FaceID без расширения (по умолчанию ищется автоматически)
# FACEID_WEIGHT=1.0           # вес ControlNet-юнита FaceID
# FACEID_LORA_WEIGHT=0.6      # вес LoRA (рекомендуется 0.5–0.7)
# FACEID_AD_DENOISE=0.25      # потолок denoise ADetailer при FaceID (иначе он «ломает» сходство)
# FACEID_UNIT_COUNT=          # сколько ControlNet-юнитов доступно, если /controlnet/settings не отвечает
# A1111_BASE_PATH=            # папка WebUI на этой машине: нужна для удаления файлов моделей лиц
